# Modo de dados do frontend
# Valores: api | static | auto
# - api: usa apenas o backend
# - static: usa apenas snapshots JSON em /static-data
# - auto: tenta backend e cai para static em erro de rede / 5xx / timeout
VITE_DATA_MODE=auto

# URL base do backend (usado nos modos api e auto)
# VITE_API_BASE_URL=https://mvp-colab-ongs-backend-c8lx.onrender.com
